# Copie para .env.local (desenvolvimento) ou cadastre na hospedagem (produção).
# Nunca versione .env.local nem coloque segredos em variáveis NEXT_PUBLIC_*.

# --- Site -------------------------------------------------------------------
# URL pública (usada em SEO, imagem de compartilhamento, sitemap).
NEXT_PUBLIC_SITE_URL=https://ligana.com.br

# --- Supabase (gravação de leads) — SECRETO, só no servidor ---------------------
# Sem estas duas variáveis, o formulário mostra "cadastro ainda não está aberto"
# e NADA é gravado (não há sucesso simulado).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contato exibido no rodapé (opcionais) ------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_INSTAGRAM=

# --- LGPD: responsável pelo tratamento (preencha antes de publicar) ------------
NEXT_PUBLIC_CONTROLLER_NAME=
# CNPJ ou CPF (opcional)
NEXT_PUBLIC_CONTROLLER_DOCUMENT=
# E-mail para pedidos de privacidade (se vazio, usa NEXT_PUBLIC_CONTACT_EMAIL)
NEXT_PUBLIC_CONTROLLER_EMAIL=
NEXT_PUBLIC_CONTROLLER_ADDRESS=

# --- Analytics (opcionais; nunca recebem dados pessoais) ----------------------
# Google Tag Manager, ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Plausible, ex.: ligana.com.br
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
